# Apache / cPanel / shared hosting.
# Upload the whole folder to public_html and issue an SSL cert
# (AutoSSL / Let's Encrypt in cPanel). This file then forces HTTPS
# and the bare domain on every request.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://ntitled.in%{REQUEST_URI} [L,R=301]

  # www -> bare domain
  RewriteCond %{HTTP_HOST} ^www\.ntitled\.in$ [NC]
  RewriteRule ^ https://ntitled.in%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io https://api.web3forms.com https://usebasin.com; form-action 'self' https://formspree.io https://api.web3forms.com https://usebasin.com; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

DirectoryIndex index.html
Options -Indexes
